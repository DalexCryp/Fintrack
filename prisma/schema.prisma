generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Transaction {
  id          String   @id @default(uuid())
  type        String // "INCOME" or "EXPENSE"
  amount      Float
  category    String // Rent, Food, Subscriptions, Salary, etc.
  description String?
  date        DateTime // Date the transaction occurred
  createdAt   DateTime @default(now())
}

model PortfolioItem {
  id        String   @id @default(uuid())
  ticker    String // e.g., AAPL, MSFT
  shares    Float // Allow fractional shares
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
